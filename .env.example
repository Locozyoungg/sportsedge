# Only needed if you later implement a live broker adapter. Never commit real keys.
LIVE_CONFIRM=
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Telegram (premium channel). If unset, posts are printed (dry run) instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=     # e.g. -1001234567890 (private channel) or @yourchannel
TELEGRAM_ADMIN_CHAT_ID=   # your private chat with the bot: diagnostics, pauses, learning reports

# Live odds feed (the-odds-api.com)
ODDS_API_KEY=

# Polymarket LIVE trading (off by default; read the README first). Use a dedicated low-balance wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0
